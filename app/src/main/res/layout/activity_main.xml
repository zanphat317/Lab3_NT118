<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Tiêu đề chính -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BROADCAST RECEIVER LAB"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="24dp" />

        <!-- Nút Bài 1 -->
        <Button
            android:id="@+id/btn_bai1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="BÀI 1 - NHẬN TIN NHẮN SMS"
            android:textSize="15sp"
            android:backgroundTint="#2E7D32"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Nút Bài 2 -->
        <Button
            android:id="@+id/btn_bai2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="BÀI 2 - TRẠNG THÁI SẠC PIN"
            android:textSize="15sp"
            android:backgroundTint="#E65100"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Nút Bài 4 -->
        <Button
            android:id="@+id/btn_bai4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="BÀI 3 - TIN NHẮN KHẨN CẤP"
            android:textSize="15sp"
            android:backgroundTint="#C2185B"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Danh sách bài tập Lab 02 trước đó -->



    </LinearLayout>

</ScrollView>