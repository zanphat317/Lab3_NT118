<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="QUẢN LÝ DANH SÁCH MÓN ĂN"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#1565C0"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_dish_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="Nhập tên món ăn"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn thumbnail:"
            android:textSize="16sp"
            android:textColor="#333333" />

        <!-- Spinner hiển thị dạng Dialog pop-up -->
        <Spinner
            android:id="@+id/sp_thumbnail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:spinnerMode="dialog"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/cb_promotion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Khuyến mãi"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add"
        android:layout_marginTop="12dp" />

    <!-- GridView hiển thị danh sách món ăn với 2 cột -->
    <GridView
        android:id="@+id/gv_dishes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="2"
        android:verticalSpacing="8dp"
        android:horizontalSpacing="8dp"
        android:stretchMode="columnWidth"
        android:layout_marginTop="12dp" />

</LinearLayout>