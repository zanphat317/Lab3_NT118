<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions and Hardware features for SMS Broadcast & Emergency Messaging -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lab_NT118">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Previous Activities -->
        <activity
            android:name=".bai1.Bai1Activity"
            android:exported="false" />

        <activity
            android:name=".bai2.Bai2Activity"
            android:exported="false" />

        <activity
            android:name=".bai3.Bai3Activity"
            android:exported="false" />

        <activity
            android:name=".bai4.Bai4Activity"
            android:exported="false" />

        <activity
            android:name=".bai5.Bai5Activity"
            android:exported="false" />

        <activity
            android:name=".bai6.Bai6Activity"
            android:exported="false" />

        <activity
            android:name=".bai7.Bai7Activity"
            android:exported="false" />

        <!-- Broadcast Receiver / Emergency Messaging Activities -->
        <activity
            android:name=".broadcast.Bai1Activity"
            android:exported="false" />

        <activity
            android:name=".broadcast.Bai2Activity"
            android:exported="false" />

        <activity
            android:name=".broadcast.Bai3Activity"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- Đăng ký tĩnh PowerStateChangeReceiver trong AndroidManifest cho Bài 2 -->
        <receiver
            android:name=".broadcast.PowerStateChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Đăng ký tĩnh SmsReceiver trong AndroidManifest cho Bài 3/Bài 4 Khẩn cấp -->
        <receiver
            android:name=".broadcast.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>